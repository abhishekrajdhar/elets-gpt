# EletsGPT 2.0 backend configuration (copy to backend/.env). All secrets come from the environment only.

ENVIRONMENT=development            # development | test | staging | production
LOG_LEVEL=INFO

# PostgreSQL 17 + pgvector. Use the password from the root .env.
DATABASE_URL=postgresql+psycopg://eletsgpt:CHANGE_ME@localhost:5433/eletsgpt
TEST_DATABASE_URL=postgresql+psycopg://eletsgpt:CHANGE_ME@localhost:5433/eletsgpt_test
DB_STATEMENT_TIMEOUT_MS=15000

# Redis (rate limiting now; Celery broker in Phase 2). If unset, falls back to in-process limits.
REDIS_URL=redis://localhost:6380/0

# Session signing key: generate with  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false                # must be true behind HTTPS (staging/production)
# CORS_ORIGINS=                    # only needed if the browser calls the API cross-origin (not the default)
LOGIN_RATE_LIMIT_PER_MINUTE=10

# First administrator (used by: uv run python -m app.cli create-admin --from-env). Remove after bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Provider credentials. Leave empty if unused; the Admin page shows which are configured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=                   # for OpenAI-compatible endpoints (Azure, vLLM, Ollama, ...)
GOOGLE_API_KEY=
VOYAGE_API_KEY=
COHERE_API_KEY=
YOUTUBE_API_KEY=                   # YouTube Data API v3 (Phase 2 video ingestion)
